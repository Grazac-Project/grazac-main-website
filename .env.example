# Copy this file to .env and fill in the values, then restart `npm start`.

# Web3Forms access key for the co-working enquiry form (web3forms.com dashboard).
# Safe to use in front-end code. Set the same variable in your hosting provider.
REACT_APP_WEB3FORMS_ACCESS_KEY=

# Sanity (blog). Project ID is on sanity.io/manage. Dataset is usually "production".
# Safe to use in front-end code (read-only). Set the same variables on Vercel.
REACT_APP_SANITY_PROJECT_ID=
REACT_APP_SANITY_DATASET=
